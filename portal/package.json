{
  "name": "@zeppelinbot/portal",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "ace": "node ace",
    "generate-db-schema": "node ace schema:generate",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project inertia/tsconfig.json"
  },
  "imports": {
    "#backend/*": "./app/*.js",
    "#frontend/*.vue": "./inertia/*.vue",
    "#frontend/*": "./inertia/*",
    "#generated/*": "./.adonisjs/server/*.js",
    "#client/*": "./.adonisjs/client/*",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:ts6",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/redis": "^11.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.2",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/vue3": "^3.7.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "@vue/server-renderer": "^3.5.43",
    "edge.js": "^6.5.1",
    "lucide-vue-next": "^1.0.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.23.0",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.43",
    "vue-sonner": "^2.0.9"
  },
  "hotHook": {
    "boundaries": [
      "./app/features/**/controllers/*.ts",
      "./app/features/**/middleware/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
